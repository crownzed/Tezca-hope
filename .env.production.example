# Copy thành .env.production rồi build: npm run build
# Hoặc đặt biến khi build (PowerShell):
#   $env:VITE_BASE_PATH="/tezca/"; npm run build
#
# Vercel: thêm cùng các biến VITE_* trong Dashboard → Settings → Environment Variables
# (Production + Preview). API /api/* chạy serverless trên cùng project — không cần host API riêng.

# Đường dẫn trên website có sẵn (bắt buộc có / đầu và cuối nếu là thư mục con)
VITE_BASE_PATH=/tezca/

# Chỉ cần nếu API ở domain/port khác (mặc định để trống = cùng domain, proxy /api)
# VITE_API_URL=https://your-domain.com

# Firebase Web (Analytics) — public, gắn lúc build Vite
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=tezca-f4608.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=tezca-f4608
# VITE_FIREBASE_STORAGE_BUCKET=tezca-f4608.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=367101667137
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
