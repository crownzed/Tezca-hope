# Sao chép thành .env (không commit file .env)

# Google Gemini — chỉ dùng trên server
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-key
GOOGLE_GENERATIVE_AI_MODEL=gemini-2.5-flash

# Giới hạn gọi AI (tùy chọn)
# AI_RATE_LIMIT_CHAT=30
# AI_RATE_LIMIT_PLAN=8

# Giới hạn auth (tùy chọn)
# AUTH_RATE_LIMIT_LOGIN=20
# AUTH_RATE_LIMIT_RESET=10
# NEWSLETTER_RATE_LIMIT=6

# Production: bắt buộc đổi secret mạnh (Vercel Dashboard → Environment Variables)
# Server sẽ TỪ CHỐI KHỚI ĐỘNG nếu thiếu JWT_SECRET trong production!
JWT_SECRET=tezca-change-me-in-production

# Tài khoản quản trị bootstrap (bắt buộc đặt trong env — không có giá trị mặc định)
# TEZCA_ADMIN_EMAIL=admin@your-domain.com
# TEZCA_ADMIN_PASSWORD=your-strong-password
# TEZCA_ADMIN_NAME=Quản trị viên
# TEZCA_ADMIN_SYNC_PASSWORD=1
# TEZCA_ADMIN_PRIMARY_ROLE=admin

# Production — https://poseidonz227.id.vn (Vercel alias chính)
# TEZCA_APP_URL=https://poseidonz227.id.vn
# NODE_ENV=production

# Seed 100 KH demo + 4 CG + dữ liệu công việc khi DB trống/thiếu (mặc định bật trên Vercel, chỉ khi NODE_ENV != production)
# TEZCA_SEED_DEMO=1
# TEZCA_SEED_DEMO=0

# Demo admin (chỉ khi TEZCA_SEED_DEMO bật + không phải production)
# TEZCA_DEMO_ADMIN_EMAIL=admin@tezca.vn
# TEZCA_DEMO_PASSWORD=your-demo-password

# Production CORS: domain frontend, phân tách bằng dấu phẩy
# TEZCA_CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Quên mật khẩu — URL frontend trong email (production)
# TEZCA_APP_URL=https://your-domain.com

# Gửi email qua Resend (https://resend.com) — tùy chọn; dev in link ra console API
# RESEND_API_KEY=re_...
# TEZCA_MAIL_FROM=Tezca <noreply@your-domain.com>

# Chỉ dev: trả resetUrl trong JSON (production dùng email)
# TEZCA_EXPOSE_RESET_LINK=1

# --- DATABASE PERSISTENCE (Production Serverless) ---
# Vercel serverless: SQLite local (/tmp) mất data mỗi cold start!
# Dùng Turso (libSQL hosted) để giữ data:
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-token
#
# Hoặc deploy trên Docker/VPS với volume mount (DATA_DIR=./data)
# DATA_DIR=./data

# --- RATE LIMIT (Production Serverless) ---
# In-memory rate limit reset mỗi cold start trên Vercel.
# Dùng Upstash Redis để rate limit hoạt động đúng:
# RATE_LIMIT_STORE_URL=redis://default:xxx@your-upstash.upstash.io:6379
