# Sao chép thành .env (không commit file .env)

# --- Firebase / Firestore (cộng đồng; đăng nhập/BMI/chat vẫn SQLite trên API) ---
# Tạo project: https://console.firebase.google.com → Project settings → Service accounts → Generate new private key
#
# Cách 1 (khuyên dùng local): đường dẫn file JSON service account
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
# FIREBASE_PROJECT_ID=your-project-id
#
# Cách 2 (Vercel / CI): JSON một dòng hoặc base64
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
#
# Cách 3: từng trường (private key dùng \n cho xuống dòng)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#
# Kiểm tra: GET http://localhost:3001/api/health/firestore
#
# Cộng đồng (/api/community/*): ghi/đọc Firestore khi Firebase đã cấu hình (mặc định bật)
# TEZCA_COMMUNITY_FIRESTORE=0   # tắt → dùng lại SQLite cho cộng đồng
# Hồ sơ khách hàng (/api/me/profile, /api/me/health-profile): Firestore khi Firebase đã cấu hình
# TEZCA_PROFILE_FIRESTORE=0     # tắt → dùng lại SQLite cho hồ sơ (local dev không cần Firebase)
# Deploy composite indexes: firebase deploy --only firestore:indexes (file firestore.indexes.json)
#
# Vercel (frontend + API cùng project — vercel.json):
#   Build: VITE_FIREBASE_* (và VITE_BASE_PATH nếu cần)
#   Runtime API: FIREBASE_PROJECT_ID + FIREBASE_SERVICE_ACCOUNT_JSON (JSON một dòng, KHÔNG dùng file path)
#   Không commit firebase-service-account.json — chỉ dán JSON vào Vercel env Production

# Firebase Web (Vite — Analytics; không thay API cộng đồng)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=tezca-f4608.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=tezca-f4608
# VITE_FIREBASE_STORAGE_BUCKET=tezca-f4608.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=367101667137
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=

# Google Gemini — chỉ dùng trên server
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-key
GOOGLE_GENERATIVE_AI_MODEL=gemini-2.5-flash

# Giới hạn gọi AI (tùy chọn)
# AI_RATE_LIMIT_CHAT=30
# AI_RATE_LIMIT_PLAN=8

# Giới hạn auth (tùy chọn)
# AUTH_RATE_LIMIT_LOGIN=20
# AUTH_RATE_LIMIT_RESET=10
# NEWSLETTER_RATE_LIMIT=6

# Production: bắt buộc đổi secret mạnh (Vercel Dashboard → Environment Variables)
JWT_SECRET=tezca-change-me-in-production

# Tài khoản quản trị bootstrap (Vercel/local — tạo khi chưa có email này)
# TEZCA_ADMIN_EMAIL=admin@your-domain.com
# TEZCA_ADMIN_PASSWORD=your-strong-password
# TEZCA_ADMIN_NAME=Quản trị viên
# TEZCA_ADMIN_SYNC_PASSWORD=1
# TEZCA_ADMIN_PRIMARY_ROLE=admin

# Production Vercel — https://tezca-hope.vercel.app
# TEZCA_APP_URL=https://tezca-hope.vercel.app
# NODE_ENV=production

# Seed 100 KH demo + 4 CG + dữ liệu công việc khi DB trống/thiếu (mặc định bật trên Vercel)
# TEZCA_SEED_DEMO=1
# TEZCA_SEED_DEMO=0

# Production CORS: domain frontend, phân tách bằng dấu phẩy
# TEZCA_CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Quên mật khẩu — URL frontend trong email (production)
# TEZCA_APP_URL=https://your-domain.com

# Gửi email qua Resend (https://resend.com) — tùy chọn; dev in link ra console API
# RESEND_API_KEY=re_...
# TEZCA_MAIL_FROM=Tezca <noreply@your-domain.com>

# Chỉ dev: trả resetUrl trong JSON (production dùng email)
# TEZCA_EXPOSE_RESET_LINK=1
